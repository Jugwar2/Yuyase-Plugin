{
  "name": "anitorrent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nyaa torrent search extension for Hayase and Shiru.",
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "test": "node test/relevance.test.mjs",
    "test:matching": "node test/matching.test.mjs",
    "test:franchise": "node test/franchise.test.mjs",
    "test:db-titles": "node test/db-titles.test.mjs",
    "test:golden": "node test/golden-harness.test.mjs",
    "test:invariants": "node test/invariants.test.mjs",
    "test:all": "node test/franchise.test.mjs && node test/matching.test.mjs && node test/db-titles.test.mjs && node test/golden-harness.test.mjs && node test/invariants.test.mjs",
    "fetch:fixture": "node .github/scripts/fetch-anime-fixture.mjs",
    "fetch:db-titles": "node .github/scripts/fetch-db-titles.mjs",
    "build:golden": "node .github/scripts/build-golden.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "opentype.js": "^2.0.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
